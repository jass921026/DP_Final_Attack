{
  "name": "balle_mnist_notebook_haiku_optax",
  "_comment": "Balle reconstruction on MNIST, official-notebook hyper-parameters, with Haiku-style initialisation and optax-style RMSProp, on MPS.",
  "device": "mps",
  "data": {
    "module": "datasets.mnist",
    "type": "MNIST",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "splits": {
    "seed": 42,
    "sizes": {
      "eval": 1000,
      "test_targets": 1000,
      "fixed": 1000,
      "shadow": 10000
    }
  },
  "released_model": {
    "module": "models.mlp",
    "type": "MLP",
    "kwargs": {
      "in_dim": 784,
      "hidden": [
        10
      ],
      "out_dim": 10,
      "activation": "elu",
      "init": "haiku"
    }
  },
  "algorithm_A": {
    "lr": 0.1,
    "momentum": 0.9,
    "epochs": 100,
    "init_seed": 42,
    "chunk_size": 500
  },
  "reconstructor": {
    "model": {
      "module": "models.mlp",
      "type": "MLP",
      "kwargs": {
        "hidden": [
          1000,
          1000
        ],
        "activation": "relu",
        "init": "haiku"
      }
    },
    "lr": 0.0003,
    "batch_size": 32,
    "epochs": 200,
    "seed": 42,
    "fit_scaler_on_train_only": true,
    "optimizer": "optax_rmsprop"
  }
}