{
  "name": "balle_mnist_paper",
  "_comment": "Balle reconstruction on MNIST with the paper's Table VI hyper-parameters: fixed set 10K, ~59K shadow models, A = GD+momentum lr 0.2 mom 0.9 100 epochs, reconstructor RMSProp lr 1e-3 batch 128 100 epochs. Needs an accelerator.",
  "device": "cpu",
  "data": {
    "module": "datasets.mnist",
    "type": "MNIST",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "splits": {
    "seed": 42,
    "sizes": {
      "eval": 1000,
      "test_targets": 1000,
      "fixed": 10000,
      "shadow": 58000
    }
  },
  "released_model": {
    "module": "models.mlp",
    "type": "MLP",
    "kwargs": {
      "in_dim": 784,
      "hidden": [
        10
      ],
      "out_dim": 10,
      "activation": "elu"
    }
  },
  "algorithm_A": {
    "lr": 0.2,
    "momentum": 0.9,
    "epochs": 100,
    "init_seed": 42,
    "chunk_size": 50
  },
  "reconstructor": {
    "model": {
      "module": "models.mlp",
      "type": "MLP",
      "kwargs": {
        "hidden": [
          1000,
          1000
        ],
        "activation": "relu"
      }
    },
    "lr": 0.001,
    "batch_size": 128,
    "epochs": 100,
    "seed": 42,
    "fit_scaler_on_train_only": true
  }
}