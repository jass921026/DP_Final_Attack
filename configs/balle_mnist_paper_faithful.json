{
  "name": "balle_mnist_paper_faithful",
  "_comment": "Balle reconstruction on MNIST, Table VI values (fixed 10K, 58K shadow models; 1K held out for evaluation); settings the paper leaves open follow the official notebook (Haiku init, optax RMSProp). MPS.",
  "device": "mps",
  "data": {
    "module": "datasets.mnist",
    "type": "MNIST",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "splits": {
    "seed": 42,
    "sizes": {
      "eval": 1000,
      "test_targets": 1000,
      "fixed": 10000,
      "shadow": 58000
    }
  },
  "released_model": {
    "module": "models.mlp",
    "type": "MLP",
    "kwargs": {
      "in_dim": 784,
      "hidden": [
        10
      ],
      "out_dim": 10,
      "activation": "elu",
      "init": "haiku"
    }
  },
  "algorithm_A": {
    "lr": 0.2,
    "momentum": 0.9,
    "epochs": 100,
    "init_seed": 42,
    "chunk_size": 500
  },
  "reconstructor": {
    "model": {
      "module": "models.mlp",
      "type": "MLP",
      "kwargs": {
        "hidden": [
          1000,
          1000
        ],
        "activation": "relu",
        "init": "haiku"
      }
    },
    "lr": 0.001,
    "batch_size": 128,
    "epochs": 100,
    "seed": 42,
    "fit_scaler_on_train_only": true,
    "optimizer": "optax_rmsprop"
  }
}