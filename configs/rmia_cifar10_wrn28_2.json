{
  "name": "rmia_cifar10_wrn28_2",
  "_comment": "RMIA with WRN-28-2 on CIFAR-10 (paper model), 9 complementary pairs (18 models), 100 epochs, 4 target models; intended for a Colab GPU (device cuda).",
  "official_attacks_path": "../rmia/ml_privacy_meter/attacks.py",
  "data": {
    "module": "datasets.cifar10",
    "type": "CIFAR10",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "model": {
    "module": "models.wrn",
    "type": "WideResNet",
    "kwargs": {
      "depth": 28,
      "widen": 2,
      "num_classes": 10
    }
  },
  "train": {
    "epochs": 100,
    "lr": 0.1,
    "batch_size": 256,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "device": "cuda"
  },
  "models": {
    "num_pairs": 9,
    "seed": 0
  },
  "audit": {
    "size": 20000,
    "seed": 1
  },
  "population": {
    "size": 10000,
    "seed": 2
  },
  "attack": {
    "targets": [
      0,
      1,
      2,
      3
    ],
    "num_ref": [
      1,
      2,
      4,
      8
    ],
    "gamma": [
      1.0,
      2.0
    ],
    "a": [
      0.3,
      "tune"
    ],
    "selection": "master",
    "check_official": false
  }
}