{
  "name": "imprint_fedsgd_bins",
  "_comment": "Imprint attack, FedSGD: 64 ImageNet-val images with distinct labels, ResNet-18 with an imprint block in front; sweep over the number of bins. Fourier mode 32, gain 1e-3, addition connection, random-init ResNet-18.",
  "data": {
    "module": "datasets.imagenet_val",
    "type": "ImageNetVal",
    "kwargs": {
      "root": "../imprint_attack/data/imagenet/data",
      "n": 64,
      "seed": 0,
      "unique_labels": true
    }
  },
  "model": {
    "module": "models.resnet",
    "type": "ResNet18",
    "kwargs": {
      "seed": 0,
      "pretrained": false
    }
  },
  "block": {
    "connection": "addition",
    "gain": 0.001,
    "linfunc": "fourier",
    "mode": 32
  },
  "sweep": {
    "num_bins": [
      16,
      32,
      64,
      128,
      156,
      256,
      512
    ]
  },
  "micro_batch": 8
}