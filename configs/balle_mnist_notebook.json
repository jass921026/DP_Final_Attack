{
  "name": "balle_mnist_notebook",
  "_comment": "Balle reconstruction on MNIST with the hyper-parameters of the official notebook: fixed set 1K, 10K shadow models, A lr 0.1, reconstructor lr 3e-4 / batch 32 / 200 epochs.",
  "device": "cpu",
  "data": {
    "module": "datasets.mnist",
    "type": "MNIST",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "splits": {
    "seed": 42,
    "sizes": {
      "eval": 1000,
      "test_targets": 1000,
      "fixed": 1000,
      "shadow": 10000
    }
  },
  "released_model": {
    "module": "models.mlp",
    "type": "MLP",
    "kwargs": {
      "in_dim": 784,
      "hidden": [
        10
      ],
      "out_dim": 10,
      "activation": "elu"
    }
  },
  "algorithm_A": {
    "lr": 0.1,
    "momentum": 0.9,
    "epochs": 100,
    "init_seed": 42,
    "chunk_size": 50
  },
  "reconstructor": {
    "model": {
      "module": "models.mlp",
      "type": "MLP",
      "kwargs": {
        "hidden": [
          1000,
          1000
        ],
        "activation": "relu"
      }
    },
    "lr": 0.0003,
    "batch_size": 32,
    "epochs": 200,
    "seed": 42,
    "fit_scaler_on_train_only": true
  }
}