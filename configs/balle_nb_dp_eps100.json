{
  "name": "balle_nb_dp_eps100",
  "_comment": "Notebook-scale Balle with DP-GD (clip 1, sigma 0.9467, T=100 full-batch steps, exact GDP eps at delta 1e-5 = 100). Adversary trains shadows with the same DP-GD.",
  "device": "mps",
  "data": {
    "module": "datasets.mnist",
    "type": "MNIST",
    "kwargs": {
      "cache_dir": "data_cache"
    }
  },
  "splits": {
    "seed": 42,
    "sizes": {
      "eval": 1000,
      "test_targets": 1000,
      "fixed": 1000,
      "shadow": 10000
    }
  },
  "released_model": {
    "module": "models.mlp",
    "type": "MLP",
    "kwargs": {
      "in_dim": 784,
      "hidden": [
        10
      ],
      "out_dim": 10,
      "activation": "elu",
      "init": "haiku"
    }
  },
  "algorithm_A": {
    "lr": 0.1,
    "momentum": 0.9,
    "epochs": 100,
    "init_seed": 42,
    "chunk_size": 500,
    "dp": {
      "clip": 1.0,
      "sigma": 0.946699,
      "seed": 0
    }
  },
  "reconstructor": {
    "model": {
      "module": "models.mlp",
      "type": "MLP",
      "kwargs": {
        "hidden": [
          1000,
          1000
        ],
        "activation": "relu",
        "init": "haiku"
      }
    },
    "lr": 0.0003,
    "batch_size": 32,
    "epochs": 200,
    "seed": 42,
    "fit_scaler_on_train_only": true,
    "optimizer": "optax_rmsprop"
  }
}